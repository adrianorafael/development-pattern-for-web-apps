# ─────────────────────────────────────────────────────────────
# .env.example. VERSIONADO. Só placeholders, nunca valor real.
# Copie para .env (PHP local) ou .env.local (Next.js) e preencha.
# Parte de "Development Pattern for Web Apps": regra R1.
#
# Todo placeholder aqui é OBVIAMENTE falso de propósito: se um valor
# parece que poderia funcionar, ele passa despercebido na revisão.
# ─────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════
# TRILHA PHP + MySQL (Hostinger)
# ══════════════════════════════════════════════════════════════
# Em produção, estes valores NÃO ficam aqui: o Wizard de instalação (R9)
# grava config/app.config.php fora do webroot. Este arquivo serve para
# desenvolvimento local e para documentar quais chaves existem.

APP_NOME="Nome do Aplicativo"
APP_URL="https://seu-dominio.com.br"
APP_AMBIENTE="local"            # local | teste | producao
APP_DEBUG="true"                # SEMPRE false em producao
APP_TIMEZONE="America/Sao_Paulo"

# Onde achar: hPanel → Bancos de dados → MySQL
DB_HOST="localhost"             # na Hostinger costuma ser localhost
DB_PORT="3306"
DB_NAME="SEU-BANCO"
DB_USER="SEU-USUARIO"
DB_PASSWORD="SUA-SENHA"
DB_PREFIXO=""                   # opcional, se a base for compartilhada

# Gere com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY="GERE-UMA-CHAVE-DE-64-CARACTERES-HEXADECIMAIS"

# SMTP. Hostinger: hPanel → E-mails → Contas de e-mail
MAIL_HOST="smtp.hostinger.com"
MAIL_PORT="587"
MAIL_USER="nao-responda@seu-dominio.com.br"
MAIL_PASSWORD="SUA-SENHA-DE-EMAIL"
MAIL_REMETENTE="nao-responda@seu-dominio.com.br"

# ══════════════════════════════════════════════════════════════
# TRILHA Next.js (Vercel)
# ══════════════════════════════════════════════════════════════
# Em produção estes valores vivem no painel da Vercel:
# Project → Settings → Environment Variables (por ambiente).

DATABASE_URL="postgres://SEU-USUARIO:SUA-SENHA@SEU-HOST/SEU-BANCO?sslmode=require"

# Gere com: openssl rand -base64 32
AUTH_SECRET="GERE-COM-openssl-rand-base64-32"

RESEND_API_KEY="re_SUA-CHAVE-AQUI"
STRIPE_SECRET_KEY="sk_test_SUA-CHAVE-DE-TESTE"

# ⚠️ TUDO com prefixo NEXT_PUBLIC_ vai para o bundle do navegador e é
# visível para qualquer visitante. Só use para valor que você imprimiria
# na página. NUNCA para senha, token ou string de conexão.
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_CHAVE-PUBLICA-DE-TESTE"

# Diagnóstico de build na Vercel (R16). Crie em Vercel → Settings → Tokens,
# com escopo mínimo. Só a máquina de quem desenvolve precisa dele: a Vercel
# não usa esse token para fazer os próprios deploys.
VERCEL_TOKEN="SEU-TOKEN-DA-VERCEL"
VERCEL_ORG_ID="SEU-ORG-ID"          # aparece em .vercel/project.json após vercel link
VERCEL_PROJECT_ID="SEU-PROJECT-ID"
