# ─────────────────────────────────────────────────────────────
# .env.example. VERSIONADO. Só placeholders, nunca valor real.
# Parte de "Development Pattern for Web Apps": regras R1 e R9.
#
# Os valores reais vivem no painel da Vercel:
#   Project → Settings → Environment Variables, um valor por ambiente
#   (Production, Preview, Development).
# Na sua máquina, não copie este arquivo à mão: rode
#   vercel link && vercel env pull .env.local
#
# Estas chaves são EXATAMENTE as do esquema em lib/env.ts (caso CT-BOOT-004).
# Chave nova entra aqui, em lib/env.ts e no painel, no mesmo commit.
#
# Todo placeholder aqui é OBVIAMENTE falso de propósito: se um valor
# parece que poderia funcionar, ele passa despercebido na revisão.
# ─────────────────────────────────────────────────────────────

# ── Supabase: criado pela integração do Marketplace da Vercel ────
# A integração cria estas variáveis em cada ambiente; na sua máquina elas
# chegam por `vercel env pull .env.local`. Preview recebe as de um branch
# do Supabase próprio: NUNCA as do projeto de produção.
# Chaves: Supabase → Settings → API Keys.
#
# Públicas: vão para o navegador e só alcançam o que a RLS permite.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUA-CHAVE-PUBLICA"
# ⚠️ SECRETA: ignora a RLS. Só no servidor (criarClienteAdmin). NUNCA com
# prefixo NEXT_PUBLIC_, nunca colada na conversa com o agente de IA.
SUPABASE_SECRET_KEY="sb_secret_SUA-CHAVE-SECRETA"
# Cópias sem prefixo que a integração também cria; o código usa as de cima.
# Públicas, como as originais: mesma URL e mesma publishable key.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUA-CHAVE-PUBLICA"

# ── Postgres direto: também criadas pela integração ──────────────
# Só para SQL no servidor (relatório, transação). Conexão direta NÃO passa
# pela RLS do usuário: a autorização tem de estar na própria consulta.
# ⚠️ SECRETAS: as URLs e POSTGRES_PASSWORD trazem a senha do banco; usuário,
# host e nome completam o acesso. Só no servidor, nunca com prefixo
# NEXT_PUBLIC_. A senha do banco se troca no painel do Supabase.
POSTGRES_URL="postgres://SEU-USUARIO:SUA-SENHA@SEU-HOST-DO-POOLER/SEU-BANCO?sslmode=require"
POSTGRES_PRISMA_URL="postgres://SEU-USUARIO:SUA-SENHA@SEU-HOST-DO-POOLER/SEU-BANCO?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://SEU-USUARIO:SUA-SENHA@SEU-HOST-DIRETO/SEU-BANCO?sslmode=require"
POSTGRES_USER="SEU-USUARIO"
POSTGRES_HOST="SEU-HOST"
POSTGRES_PASSWORD="SUA-SENHA-DO-BANCO"
POSTGRES_DATABASE="SEU-BANCO"

# ── Administrador inicial: lidas por npm run db:seed (R9) ────────
# O seed cria o usuário no Supabase Auth com app_metadata.papel = 'admin'.
# E-mail e nome: você escolhe; não são secretos.
ADMIN_EMAIL="usuario@example.com"
ADMIN_NOME="Administrador"
# ⚠️ SECRETA. Você escolhe; mínimo de 12 caracteres. Sem ela, o seed recusa:
# não existe senha padrão.
# Cadastre com `vercel env add ADMIN_SENHA_INICIAL <ambiente>`: o CLI pergunta
# o valor, que não passa pela conversa com o agente nem pelo histórico.
# Vale só até o primeiro login, que obriga a troca. Depois disso, apague-a
# do ambiente Production no painel.
ADMIN_SENHA_INICIAL="SUA-SENHA-INICIAL-COM-12-OU-MAIS"

# ── Serviços opcionais: mantenha só o que o projeto usa ──────────
# Resend: painel do Resend → API Keys. ⚠️ SECRETA: só no servidor.
RESEND_API_KEY="re_SUA-CHAVE-AQUI"
# Stripe: chaves de API no painel do Stripe. ⚠️ SECRETA. Descomente aqui E em
# lib/env.ts. Em Preview e Development, só chave de teste.
# STRIPE_SECRET_KEY="sk_test_SUA-CHAVE-DE-TESTE"

# ── Público ──────────────────────────────────────────────────────
# ⚠️ TUDO com prefixo NEXT_PUBLIC_ vai para o bundle do navegador e é
# visível para qualquer visitante. Só use para valor que você imprimiria
# na página. NUNCA para senha, token, secret key ou string de conexão.
# As duas NEXT_PUBLIC_SUPABASE_ do topo são as únicas do Supabase com o prefixo.
# O endereço do app: o domínio de produção configurado no projeto da Vercel.
# Pública.
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"
# Publishable key do Stripe, mesmo painel da secreta. Pública por definição.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_CHAVE-PUBLICA-DE-TESTE"

# ── Definida pela Vercel em cada deploy: NÃO cadastre no painel ──
# Não é secreta. production, preview ou development. Rota ou flag de
# diagnóstico só existe quando ela NÃO é production. Localmente, development.
VERCEL_ENV="development"

# ── Diagnóstico de build (R16) ───────────────────────────────────
# Só na máquina de quem diagnostica: NÃO cadastre no painel do projeto.
# Crie em Vercel → Account Settings → Tokens, com escopo mínimo e expiração.
# ⚠️ SECRETO: dá acesso à sua conta da Vercel. Nunca colado na conversa.
# A Vercel não usa este token para fazer os próprios deploys.
VERCEL_TOKEN="SEU-TOKEN-DA-VERCEL"
