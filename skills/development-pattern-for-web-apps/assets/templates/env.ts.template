/**
 * lib/env.ts: toda variável de ambiente do servidor, validada na carga.
 *
 * Parte de "Development Pattern for Web Apps": regras R1 e R9.
 * Detalhes: references/bootstrap-do-ambiente.md e references/segredos-e-configuracao.md
 *
 * REGRAS
 *   1. O resto do código lê `env.X`, nunca `process.env.X` direto. Um único lugar
 *      descobre que falta uma variável, e descobre cedo.
 *   2. Toda chave daqui existe no .env.example, e vice-versa (caso CT-BOOT-004).
 *   3. A mensagem de erro diz QUAL variável e ONDE configurar. Nunca imprime o valor.
 *   4. `server-only` transforma um import a partir de Client Component em erro de
 *      build: a secret key do Supabase e a string de conexão nunca chegam ao
 *      navegador. A única exceção à regra 1 é lib/supabase/browser.ts, que lê as
 *      duas variáveis NEXT_PUBLIC_ por extenso (supabase-browser.ts.template).
 *
 * QUEBRAR O BUILD QUANDO FALTAR VARIÁVEL
 *   O pacote server-only lança erro quando importado fora da condição "react-server"
 *   (package.json dele: "react-server" → empty.js, "default" → index.js, que lança).
 *   Para rodar este arquivo direto no Node, passe a condição. No package.json:
 *
 *     "prebuild":  "node --conditions=react-server --env-file-if-exists=.env.local lib/env.ts",
 *     "check:env": "node --conditions=react-server --env-file-if-exists=.env.local lib/env.ts"
 *
 *   O npm roda "prebuild" antes de "build", inclusive no build da Vercel, onde as
 *   variáveis do ambiente (Production ou Preview) já estão em process.env.
 *   Node 24 executa TypeScript por remoção de tipos: por isso este arquivo só usa
 *   anotações de tipo apagáveis (nada de enum nem namespace). Sem "type": "module"
 *   no package.json, o Node avisa que reinterpretou o arquivo como ES module e
 *   executa mesmo assim; com "type": "commonjs" explícito, ele falha.
 *
 * Conferido em zod@4.6.5 (z.url, z.email, regex, startsWith, safeParse, error.issues) e
 * server-only@0.0.1, node v24.21.0, 2026-10-10. Nomes das variáveis do Supabase:
 * os que a integração da Vercel cria (vercel.com/marketplace/supabase) e os do
 * guia de SSR (supabase.com/docs/guides/auth/server-side/creating-a-client).
 */

import 'server-only';
import { z } from 'zod';

// Onde cada variável é configurada. Entra na mensagem de erro.
const ONDE =
  'Configure no painel da Vercel (Project → Settings → Environment Variables), ' +
  'no ambiente certo (Production, Preview ou Development), e rode ' +
  '`vercel env pull .env.local` para trazer os valores de Development para a sua máquina.';

const POSTGRES = { protocol: /^postgres(ql)?$/, error: 'precisa ser uma URL postgres:// ou postgresql://' };

/**
 * O contrato do ambiente: uma chave por variável que o app ou o seed lê, com o
 * formato que ela precisa ter. Obrigatória sem `.optional()`; a mensagem de cada
 * regra aparece no erro de carga, ao lado do NOME da variável.
 */
const EsquemaServidor = z.object({
  // ── Supabase (pela integração do Marketplace da Vercel) ─────────────────
  // A integração cria estas variáveis em cada ambiente. Preview recebe as de
  // um branch do Supabase próprio: NUNCA as do projeto de produção.
  //
  // Públicas: vão para o navegador (lib/supabase/browser.ts) e só alcançam o
  // que a RLS permite. Validadas aqui para o build quebrar se faltarem.
  NEXT_PUBLIC_SUPABASE_URL: z.url({ protocol: /^https?$/, error: 'precisa ser a URL do projeto (https://SEU-PROJETO.supabase.co)' }),
  // eyJ...: chave legada (anon / service_role, em JWT). Aceita porque projeto
  // antigo e o stack local (`supabase status`) ainda podem mostrar só a legada.
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: z
    .string()
    .regex(/^(sb_publishable_|eyJ)/, 'precisa ser a chave publishable (sb_publishable_...), nunca a secret'),
  // SECRETA: ignora a RLS (papel service_role). Só em lib/supabase/server.ts,
  // dentro de criarClienteAdmin(). NUNCA com prefixo NEXT_PUBLIC_.
  SUPABASE_SECRET_KEY: z.string().regex(/^(sb_secret_|eyJ)/, 'precisa ser a chave secret (sb_secret_...)'),
  // Cópias sem prefixo que a integração também cria. O código usa as de cima.
  SUPABASE_URL: z.url({ protocol: /^https?$/ }).optional(),
  SUPABASE_PUBLISHABLE_KEY: z.string().regex(/^(sb_publishable_|eyJ)/).optional(),

  // ── Postgres direto (SQL no servidor, sem passar pela RLS do usuário) ───
  // Opcionais: só para relatório e transação (references/sql-e-acesso-a-dados.md).
  // Quem conecta por aqui NÃO passa pela RLS: a autorização vai na consulta.
  POSTGRES_URL: z.url(POSTGRES).optional(),
  POSTGRES_PRISMA_URL: z.url(POSTGRES).optional(),
  POSTGRES_URL_NON_POOLING: z.url(POSTGRES).optional(),
  POSTGRES_USER: z.string().min(1).optional(),
  POSTGRES_HOST: z.string().min(1).optional(),
  POSTGRES_PASSWORD: z.string().min(1).optional(),
  POSTGRES_DATABASE: z.string().min(1).optional(),

  // ── Administrador inicial (lidas pelo seed, R9) ─────────────────────────
  ADMIN_EMAIL: z.email('precisa ser um e-mail válido'),
  // Opcional no app: só o seed precisa dela. Depois do primeiro login do
  // administrador, apague-a do painel de Production.
  ADMIN_SENHA_INICIAL: z.string().min(12, 'precisa ter pelo menos 12 caracteres').optional(),
  ADMIN_NOME: z.string().trim().min(1).max(120).optional(),

  // ── Serviços opcionais: mantenha só o que o projeto usa ─────────────────
  // Serviço novo entra aqui e no .env.example no mesmo commit, com o prefixo
  // que a chave real tem (o Stripe, por exemplo, usa sk_ e um startsWith('sk_')).
  RESEND_API_KEY: z.string().startsWith('re_', 'chaves do Resend começam com re_').optional(),

  // ── Público: vai para o navegador. NUNCA segredo com este prefixo. ──────
  NEXT_PUBLIC_SITE_URL: z.url({ protocol: /^https?$/, error: 'precisa ser uma URL http(s)' }),

  // ── Definida pela própria Vercel em build e runtime (não cadastre) ─────
  // production, preview ou development. Exige "Enable access to System
  // Environment Variables" ligado no painel (vercel.com/docs/environment-variables/
  // system-environment-variables). Use para desligar diagnóstico em produção.
  VERCEL_ENV: z.enum(['production', 'preview', 'development']).optional(),

  // ── Só na máquina de quem diagnostica o build (R16) ─────────────────────
  VERCEL_TOKEN: z.string().min(1).optional(),
});

/** O ambiente já validado: opcionais podem ser undefined; obrigatórias, nunca. */
export type Env = z.infer<typeof EsquemaServidor>;

/**
 * Os nomes de todas as variáveis do esquema, obrigatórias e opcionais. Existe
 * para o teste que compara o esquema com o .env.example (CT-BOOT-004).
 */
export const CHAVES_DO_AMBIENTE = Object.keys(EsquemaServidor.shape);

/**
 * Valida process.env contra o esquema, uma única vez, na carga do módulo.
 *
 * @returns O ambiente validado, com os tipos do esquema.
 * @throws Error listando, uma por linha, cada variável ausente ou inválida e
 *   onde configurá-la. A mensagem nunca contém valor: ela vai para o log de
 *   build, que mais gente lê.
 */
function carregar(): Env {
  const r = EsquemaServidor.safeParse(process.env);
  if (r.success) return r.data;

  // Uma linha por problema, com o NOME da variável. O valor nunca é impresso:
  // a mensagem vai para o log de build, que mais gente lê.
  const linhas = r.error.issues.map((problema) => {
    const nome = String(problema.path[0] ?? '(desconhecida)');
    const faltando = process.env[nome] === undefined || process.env[nome] === '';
    return faltando
      ? '  - ' + nome + ': não definida'
      : '  - ' + nome + ': ' + problema.message;
  });

  throw new Error(
    'Variáveis de ambiente inválidas:\n' + linhas.join('\n') + '\n\n' + ONDE +
    '\nA lista completa, com um comentário por chave, está no .env.example.',
  );
}

/**
 * O ambiente do servidor, validado. É por aqui que o resto do código lê
 * variável, nunca por process.env. Importar este módulo com variável ausente ou
 * inválida lança o erro de `carregar()`.
 *
 * @example
 *   import { env } from '@/lib/env';
 *   const linkDeEntrada = new URL('/entrar', env.NEXT_PUBLIC_SITE_URL);
 */
export const env: Env = carregar();
