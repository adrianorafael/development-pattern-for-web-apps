<?php
/**
 * install/index.php — Wizard de instalação
 *
 * Parte de "Development Pattern for Web Apps" — regra R9.
 * Esqueleto funcional em arquivo único. Adapte APP_SLUG, TABELAS_DO_APP,
 * o schema em database/schema.sql e os requisitos em requisitos().
 *
 * Cinco passos:
 *   1 REQUISITOS  → 2 BANCO → 3 ESTRATÉGIA → 4 ADMIN → 5 CONCLUSÃO
 *
 * Nada é gravado antes do passo 5. Desistir no meio não deixa resíduo.
 * Ao terminar, o instalador se tranca e instrui a apagar esta pasta.
 */

declare(strict_types=1);

// ── Constantes do app ────────────────────────────────────────────────────────
const APP_SLUG    = 'meu-app';
const APP_NOME    = 'Nome do Aplicativo';
const APP_VERSAO  = '0.1.0';
const PHP_MINIMO  = '8.1.0';

/** Só estas tabelas podem ser removidas em "limpar e recriar". Allowlist (R5). */
const TABELAS_DO_APP = ['schema_migrations', 'usuarios', 'chamados', 'anexos', 'configuracoes'];

/** Migrações já contempladas pelo schema base — registradas para o updater (R10/R13). */
const MIGRACOES_BASE = ['0001_estrutura_inicial.sql'];

define('RAIZ',         dirname(__DIR__));
define('CAMINHO_CONFIG', RAIZ . '/config/app.config.php');
define('CAMINHO_LOCK',   RAIZ . '/config/instalado.lock');
define('CAMINHO_SCHEMA', RAIZ . '/database/schema.sql');

// ── Trava: já instalado? ─────────────────────────────────────────────────────
if (is_file(CAMINHO_LOCK)) {
    http_response_code(403);
    exit('Este aplicativo já está instalado. Para reinstalar, remova config/instalado.lock via FTP.');
}

session_start();
$_SESSION['csrf'] ??= bin2hex(random_bytes(32));
$_SESSION['wizard'] ??= [];

// ── Utilitários ──────────────────────────────────────────────────────────────
function e(?string $v): string {
    return htmlspecialchars($v ?? '', ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function conferirCsrf(): void {
    if ($_SERVER['REQUEST_METHOD'] !== 'POST') { return; }
    if (!hash_equals($_SESSION['csrf'] ?? '', $_POST['_csrf'] ?? '')) {
        http_response_code(419);
        exit('Sessão expirada. Recarregue a página e comece de novo.');
    }
}

function irPara(int $passo): never {
    header('Location: ?passo=' . $passo);
    exit;
}

/** Traduz o erro do MySQL para algo acionável (R9, passo 2). */
function traduzirErroPdo(PDOException $e): string {
    $m = $e->getMessage();
    return match (true) {
        str_contains($m, '1045') => 'Usuário ou senha incorretos. Confira em hPanel → Bancos de dados MySQL.',
        str_contains($m, '2002'), str_contains($m, '2005')
            => 'Não foi possível alcançar o servidor. Na Hostinger o host costuma ser "localhost".',
        str_contains($m, '1049') => 'O banco informado não existe. Crie-o no hPanel — o instalador cria as tabelas, não a base.',
        str_contains($m, '1044') => 'O usuário não tem permissão neste banco. Associe o usuário ao banco no hPanel.',
        default                  => 'Não foi possível conectar ao banco de dados. Confira os dados informados.',
    };
}

function conectar(array $d): PDO {
    return new PDO(
        sprintf('mysql:host=%s;port=%d;dbname=%s;charset=utf8mb4', $d['host'], (int)$d['porta'], $d['banco']),
        $d['usuario'],
        $d['senha'],
        [
            PDO::ATTR_ERRMODE          => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_EMULATE_PREPARES => false,      // R5 — o item crítico
            PDO::ATTR_TIMEOUT          => 5,
        ]
    );
}

// ── Passo 1: requisitos ──────────────────────────────────────────────────────
/** @return array<int,array{nome:string,ok:bool,encontrado:string,exigido:string,acao:string,obrigatorio:bool}> */
function requisitos(): array {
    $r = [];
    $add = function (string $nome, bool $ok, string $encontrado, string $exigido,
                     string $acao, bool $obrigatorio = true) use (&$r): void {
        $r[] = compact('nome', 'ok', 'encontrado', 'exigido', 'acao', 'obrigatorio');
    };

    $add('Versão do PHP', version_compare(PHP_VERSION, PHP_MINIMO, '>='),
         PHP_VERSION, PHP_MINIMO . ' ou superior',
         'hPanel → Avançado → Configuração PHP → selecione uma versão compatível.');

    foreach ([
        'pdo_mysql' => ['Acesso ao MySQL', true],
        'mbstring'  => ['Textos com acentuação', true],
        'json'      => ['Serialização de dados', true],
        'openssl'   => ['Geração de tokens seguros', true],
        'fileinfo'  => ['Validação de uploads', true],
        'zip'       => ['Painel de atualização (pacotes ZIP)', true],
        'gd'        => ['Manipulação de imagens', false],
        'intl'      => ['Formatação regional', false],
    ] as $ext => [$para, $obrig]) {
        $add("Extensão {$ext} — {$para}", extension_loaded($ext),
             extension_loaded($ext) ? 'presente' : 'ausente', 'presente',
             "hPanel → Configuração PHP → marque a extensão {$ext}.", $obrig);
    }

    foreach (['config' => 'gravar a configuração', 'storage' => 'uploads, logs e backups'] as $dir => $para) {
        $caminho = RAIZ . '/' . $dir;
        if (!is_dir($caminho)) { @mkdir($caminho, 0755, true); }
        $add("Escrita em {$dir}/ — {$para}", is_dir($caminho) && is_writable($caminho),
             is_dir($caminho) ? (is_writable($caminho) ? 'gravável' : 'somente leitura') : 'não existe',
             'gravável',
             "Crie a pasta {$dir}/ no gerenciador de arquivos e aplique permissão 755.");
    }

    $https = (($_SERVER['HTTPS'] ?? '') === 'on') || (($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '') === 'https');
    $add('HTTPS ativo', $https, $https ? 'sim' : 'não', 'sim',
         'hPanel → Segurança → SSL. Ative o certificado gratuito antes de usar em produção.', false);

    $add('Limite de upload', true, ini_get('upload_max_filesize') ?: '?', 'informativo',
         'Define o tamanho máximo do pacote de atualização.', false);
    $add('Tempo de execução', true, (ini_get('max_execution_time') ?: '?') . 's', 'informativo',
         'Migrações longas serão executadas em lotes.', false);

    return $r;
}

// ── Fluxo ────────────────────────────────────────────────────────────────────
conferirCsrf();
$passo  = max(1, min(5, (int)($_GET['passo'] ?? 1)));
$w      = &$_SESSION['wizard'];
$erros  = [];
$aviso  = null;

// Passo 2 — testar a conexão
if ($passo === 2 && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $dados = [
        'host'    => trim((string)($_POST['host']    ?? 'localhost')),
        'porta'   => (int)($_POST['porta'] ?? 3306),
        'banco'   => trim((string)($_POST['banco']   ?? '')),
        'usuario' => trim((string)($_POST['usuario'] ?? '')),
        'senha'   => (string)($_POST['senha']        ?? ''),
        'prefixo' => preg_replace('/[^a-z0-9_]/i', '', (string)($_POST['prefixo'] ?? '')) ?? '',
    ];
    if ($dados['banco'] === '' || $dados['usuario'] === '') {
        $erros[] = 'Informe ao menos o nome do banco e o usuário.';
    } else {
        try {
            $pdo = conectar($dados);
            $versaoMysql = (string)$pdo->query('SELECT VERSION()')->fetchColumn();

            // Charset da base: se não for utf8mb4, acentos e emoji quebram.
            $cs = $pdo->query("SHOW VARIABLES LIKE 'character_set_database'")->fetch(PDO::FETCH_ASSOC);
            if (($cs['Value'] ?? '') !== 'utf8mb4') {
                $aviso = 'A base usa charset "' . e((string)($cs['Value'] ?? '?')) .
                         '". Recomendado: utf8mb4. Acentos e emoji podem ser gravados incorretamente.';
            }

            // Estado da base: quais tabelas do app já existem?
            $existentes = [];
            foreach ($pdo->query('SHOW TABLES', PDO::FETCH_COLUMN) as $t) {
                $semPrefixo = $dados['prefixo'] !== '' && str_starts_with((string)$t, $dados['prefixo'])
                    ? substr((string)$t, strlen($dados['prefixo'])) : (string)$t;
                if (in_array($semPrefixo, TABELAS_DO_APP, true)) { $existentes[] = (string)$t; }
            }

            $w['db']          = $dados;
            $w['mysql']       = $versaoMysql;
            $w['existentes']  = $existentes;
            $w['aviso']       = $aviso;
            irPara(3);
        } catch (PDOException $ex) {
            error_log('[install] ' . $ex->getMessage());
            $erros[] = traduzirErroPdo($ex);
        }
    }
}

// Passo 3 — estratégia
if ($passo === 3 && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $estrategia = (string)($_POST['estrategia'] ?? '');
    if (!in_array($estrategia, ['criar', 'manter', 'recriar'], true)) {
        $erros[] = 'Escolha uma opção para continuar.';
    } elseif ($estrategia === 'recriar' && ($_POST['confirmacao'] ?? '') !== 'APAGAR') {
        $erros[] = 'Para limpar e recriar, digite APAGAR no campo de confirmação.';
    } else {
        $w['estrategia'] = $estrategia;
        irPara($estrategia === 'manter' ? 5 : 4);
    }
}

// Passo 4 — administrador
if ($passo === 4 && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $nome  = trim((string)($_POST['nome'] ?? ''));
    $email = filter_var(trim((string)($_POST['email'] ?? '')), FILTER_VALIDATE_EMAIL);
    $senha = (string)($_POST['senha'] ?? '');

    if ($nome === '' || mb_strlen($nome) > 120)  { $erros[] = 'Informe um nome de 1 a 120 caracteres.'; }
    if ($email === false)                        { $erros[] = 'Informe um e-mail válido.'; }
    if (mb_strlen($senha) < 10)                  { $erros[] = 'A senha precisa de ao menos 10 caracteres.'; }
    if ($senha !== ($_POST['senha_confirmacao'] ?? '')) { $erros[] = 'As senhas não conferem.'; }
    if (in_array(strtolower($senha), ['admin', 'administrador', '1234567890', 'senha12345'], true)) {
        $erros[] = 'Escolha uma senha menos previsível.';
    }

    if ($erros === []) {
        $w['admin'] = ['nome' => $nome, 'email' => $email, 'hash' => password_hash($senha, PASSWORD_DEFAULT)];
        irPara(5);
    }
}

// Passo 5 — executar
$relatorio = [];
if ($passo === 5 && $_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['acao'] ?? '') === 'instalar') {
    try {
        if (empty($w['db'])) { throw new RuntimeException('Dados do banco ausentes. Recomece pelo passo 2.'); }
        $pdo     = conectar($w['db']);
        $prefixo = $w['db']['prefixo'] ?? '';

        // 5.1 — limpar, quando pedido. Só tabelas da allowlist. Nunca DROP DATABASE.
        if (($w['estrategia'] ?? '') === 'recriar') {
            $pdo->exec('SET FOREIGN_KEY_CHECKS = 0');
            try {
                foreach (TABELAS_DO_APP as $t) {
                    $nomeTabela = str_replace('`', '``', $prefixo . $t);
                    // $nomeTabela sai de TABELAS_DO_APP (allowlist) com as crases escapadas,
                    // scan-sql:allow — e $prefixo foi sanitizado com preg_replace no passo 2.
                    $pdo->exec("DROP TABLE IF EXISTS `{$nomeTabela}`");
                    $relatorio[] = "Removida: {$prefixo}{$t}";
                }
            } finally {
                $pdo->exec('SET FOREIGN_KEY_CHECKS = 1');
            }
        }

        // 5.2 — criar o schema (idempotente: CREATE TABLE IF NOT EXISTS)
        if (($w['estrategia'] ?? '') !== 'manter') {
            if (!is_file(CAMINHO_SCHEMA)) { throw new RuntimeException('Arquivo database/schema.sql não encontrado.'); }
            $sql = (string)file_get_contents(CAMINHO_SCHEMA);
            if ($prefixo !== '') { $sql = str_replace('{{prefixo}}', $prefixo, $sql); }
            else                 { $sql = str_replace('{{prefixo}}', '',       $sql); }
            $pdo->exec($sql);
            $relatorio[] = 'Estrutura criada a partir de database/schema.sql';
        }

        // 5.3 — registrar as migrações já contempladas (R13)
        // scan-sql:allow — $prefixo é sanitizado com preg_replace no passo 2; o dado vai em :v
        $ins = $pdo->prepare("INSERT IGNORE INTO `{$prefixo}schema_migrations` (versao) VALUES (:v)");
        foreach (MIGRACOES_BASE as $m) { $ins->execute([':v' => $m]); }
        $relatorio[] = 'Versão do schema registrada: ' . implode(', ', MIGRACOES_BASE);

        // 5.4 — administrador
        if (!empty($w['admin'])) {
            $stmt = $pdo->prepare(
                // scan-sql:allow — $prefixo sanitizado no passo 2; nome, e-mail e hash vão vinculados
                "INSERT INTO `{$prefixo}usuarios` (nome, email, senha_hash, papel, ativo, criado_em)
                 VALUES (:n, :e, :h, 'admin', 1, NOW())
                 ON DUPLICATE KEY UPDATE senha_hash = VALUES(senha_hash), papel = 'admin', ativo = 1"
            );
            $stmt->execute([':n' => $w['admin']['nome'], ':e' => $w['admin']['email'], ':h' => $w['admin']['hash']]);
            $relatorio[] = 'Administrador criado: ' . $w['admin']['email'];
        }

        // 5.5 — gravar a configuração fora do webroot
        $config = [
            'app' => [
                'nome'     => APP_NOME,
                'url'      => rtrim((string)($_POST['url_base'] ?? ''), '/'),
                'ambiente' => 'producao',
                'debug'    => false,
                'timezone' => 'America/Sao_Paulo',
                'versao'   => APP_VERSAO,
            ],
            'db'      => $w['db'],
            'app_key' => bin2hex(random_bytes(32)),
        ];
        $conteudo = "<?php\n// Gerado pelo instalador em " . date('c') . ". NÃO versionar.\n"
                  . "declare(strict_types=1);\nreturn " . var_export($config, true) . ";\n";

        if (@file_put_contents(CAMINHO_CONFIG, $conteudo, LOCK_EX) === false) {
            throw new RuntimeException('Não foi possível gravar config/app.config.php. Verifique a permissão da pasta.');
        }
        @chmod(CAMINHO_CONFIG, 0640);
        $relatorio[] = 'Configuração gravada em config/app.config.php (0640)';

        // 5.6 — se config/ estiver dentro do webroot, negar acesso e TESTAR
        $htaccess = RAIZ . '/config/.htaccess';
        if (!is_file($htaccess)) {
            @file_put_contents($htaccess, "Require all denied\n");
            $relatorio[] = 'config/.htaccess criado (nega acesso pelo navegador)';
        }

        // 5.7 — trancar o instalador
        file_put_contents(CAMINHO_LOCK, date('c') . ' v' . APP_VERSAO . PHP_EOL, LOCK_EX);
        $relatorio[] = 'Instalador trancado (config/instalado.lock)';

        $w = ['concluido' => true, 'relatorio' => $relatorio, 'admin_email' => $w['admin']['email'] ?? null];

    } catch (Throwable $ex) {
        error_log('[install] ' . $ex->getMessage());
        $erros[] = $ex->getMessage();
    }
}

$existentes = $w['existentes'] ?? [];
$csrf       = $_SESSION['csrf'];
?><!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Instalação — <?= e(APP_NOME) ?></title>
<style>
  :root { --ok:#15803d; --erro:#b91c1c; --aviso:#b45309; --borda:#e2e8f0; --texto:#0f172a; --fraco:#64748b; }
