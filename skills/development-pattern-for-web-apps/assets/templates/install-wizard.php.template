  .sub { color:var(--fraco); margin:0 0 1.5rem; }
  .passos { display:flex; gap:.5rem; margin-bottom:1.5rem; flex-wrap:wrap; }
  .passos span { flex:1; min-width:110px; font-size:.78rem; padding:.5rem; text-align:center;
                 border-radius:6px; background:#f1f5f9; color:var(--fraco); }
  .passos .atual { background:var(--texto); color:#fff; font-weight:600; }
  .passos .feito { background:#dcfce7; color:var(--ok); }
  table { width:100%; border-collapse:collapse; font-size:.9rem; }
  th,td { text-align:left; padding:.6rem .5rem; border-bottom:1px solid var(--borda); vertical-align:top; }
  th { font-size:.75rem; text-transform:uppercase; color:var(--fraco); }
  .ok { color:var(--ok); font-weight:700; } .falha { color:var(--erro); font-weight:700; }
  .opcional { color:var(--aviso); font-weight:700; }
  label { display:block; font-weight:600; font-size:.88rem; margin:1rem 0 .25rem; }
  input[type=text],input[type=password],input[type=email],input[type=number],input[type=url] {
    width:100%; padding:.6rem .7rem; border:1px solid var(--borda); border-radius:8px; font-size:1rem; }
  .dica { font-size:.8rem; color:var(--fraco); margin-top:.2rem; }
  button { margin-top:1.5rem; padding:.7rem 1.4rem; border:0; border-radius:8px; background:var(--texto);
           color:#fff; font-size:1rem; font-weight:600; cursor:pointer; }
  button[disabled] { background:#cbd5e1; cursor:not-allowed; }
  .alerta { padding:.8rem 1rem; border-radius:8px; margin:1rem 0; font-size:.9rem; }
  .alerta.erro   { background:#fef2f2; border:1px solid #fecaca; color:var(--erro); }
  .alerta.aviso  { background:#fffbeb; border:1px solid #fde68a; color:var(--aviso); }
  .alerta.perigo { background:#fef2f2; border:2px solid var(--erro); color:var(--erro); }
  .alerta.sucesso{ background:#f0fdf4; border:1px solid #bbf7d0; color:var(--ok); }
  .opcao { border:1px solid var(--borda); border-radius:8px; padding:1rem; margin-bottom:.75rem; }
  .opcao input { margin-right:.5rem; }
  code { background:#f1f5f9; padding:.1rem .35rem; border-radius:4px; font-size:.88em; }
  ul { margin:.5rem 0; padding-left:1.2rem; }
</style>
</head>
<body>
<div class="caixa">
  <h1>Instalação — <?= e(APP_NOME) ?></h1>
  <p class="sub">Versão <?= e(APP_VERSAO) ?></p>

  <div class="passos">
    <?php foreach (['Requisitos','Banco de dados','Estrutura','Administrador','Conclusão'] as $i => $rotulo): ?>
      <span class="<?= $passo === $i+1 ? 'atual' : ($passo > $i+1 ? 'feito' : '') ?>">
        <?= $i+1 ?>. <?= e($rotulo) ?>
      </span>
    <?php endforeach; ?>
  </div>

  <?php foreach ($erros as $msg): ?>
    <div class="alerta erro"><?= e($msg) ?></div>
  <?php endforeach; ?>
  <?php if (!empty($w['aviso']) && $passo === 3): ?>
    <div class="alerta aviso"><?= $w['aviso'] ?></div>
  <?php endif; ?>

<?php if ($passo === 1):
    $reqs = requisitos();
    $bloqueia = array_filter($reqs, static fn($r) => $r['obrigatorio'] && !$r['ok']);
?>
  <p>Conferindo se este servidor atende aos requisitos do aplicativo.</p>
  <table>
    <thead><tr><th>Item</th><th>Encontrado</th><th>Exigido</th><th></th></tr></thead>
    <tbody>
    <?php foreach ($reqs as $r): ?>
      <tr>
        <td><?= e($r['nome']) ?>
          <?php if (!$r['ok']): ?><div class="dica"><?= e($r['acao']) ?></div><?php endif; ?>
        </td>
        <td><?= e($r['encontrado']) ?></td>
        <td><?= e($r['exigido']) ?></td>
        <td class="<?= $r['ok'] ? 'ok' : ($r['obrigatorio'] ? 'falha' : 'opcional') ?>">
          <?= $r['ok'] ? '✓' : ($r['obrigatorio'] ? '✗' : '!') ?>
        </td>
      </tr>
    <?php endforeach; ?>
    </tbody>
  </table>

  <?php if ($bloqueia): ?>
    <div class="alerta erro">
      <?= count($bloqueia) ?> requisito(s) obrigatório(s) não atendido(s). Ajuste no hPanel e verifique novamente.
    </div>
    <form method="get"><button type="submit">Verificar novamente</button></form>
  <?php else: ?>
    <form method="get"><input type="hidden" name="passo" value="2"><button type="submit">Continuar</button></form>
  <?php endif; ?>

<?php elseif ($passo === 2): ?>
  <p>Informe os dados do banco MySQL. Na Hostinger eles estão em
     <strong>hPanel → Bancos de dados → MySQL</strong>.</p>
  <div class="alerta aviso">
    O instalador cria as <strong>tabelas</strong> dentro de uma base que já existe.
    Crie a base no hPanel antes de continuar — o usuário do plano compartilhado
    normalmente não tem permissão para <code>CREATE DATABASE</code>.
  </div>
  <form method="post">
    <input type="hidden" name="_csrf" value="<?= e($csrf) ?>">
    <label for="host">Servidor</label>
    <input type="text" id="host" name="host" value="<?= e($_POST['host'] ?? 'localhost') ?>" required>
    <p class="dica">Na Hostinger costuma ser <code>localhost</code>.</p>

    <label for="porta">Porta</label>
    <input type="number" id="porta" name="porta" value="<?= e((string)($_POST['porta'] ?? '3306')) ?>" required>

    <label for="banco">Nome do banco</label>
    <input type="text" id="banco" name="banco" value="<?= e($_POST['banco'] ?? '') ?>" required maxlength="64">

    <label for="usuario">Usuário</label>
    <input type="text" id="usuario" name="usuario" value="<?= e($_POST['usuario'] ?? '') ?>" required maxlength="64">

    <label for="senha">Senha</label>
    <input type="password" id="senha" name="senha" autocomplete="off" required>

    <label for="prefixo">Prefixo das tabelas (opcional)</label>
    <input type="text" id="prefixo" name="prefixo" value="<?= e($_POST['prefixo'] ?? '') ?>" maxlength="16">
    <p class="dica">Use se esta base for compartilhada com outro aplicativo. Ex.: <code>app_</code></p>

    <button type="submit">Testar conexão e continuar</button>
  </form>

<?php elseif ($passo === 3): ?>
  <p>Conectado ao MySQL <strong><?= e($w['mysql'] ?? '?') ?></strong>.</p>
  <form method="post">
    <input type="hidden" name="_csrf" value="<?= e($csrf) ?>">
    <?php if ($existentes === []): ?>
      <div class="alerta sucesso">Nenhuma tabela deste aplicativo foi encontrada. A estrutura será criada do zero.</div>
      <input type="hidden" name="estrategia" value="criar">
    <?php else: ?>
      <div class="alerta aviso">
        Já existem tabelas deste aplicativo nesta base:
        <ul><?php foreach ($existentes as $t): ?><li><code><?= e($t) ?></code></li><?php endforeach; ?></ul>
      </div>
      <div class="opcao">
        <label style="font-weight:600;margin:0">
