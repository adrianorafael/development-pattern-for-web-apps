  body { font-family:system-ui,-apple-system,"Segoe UI",sans-serif; background:#f8fafc; color:var(--texto);
         margin:0; padding:2rem 1rem; line-height:1.55; }
  .caixa { max-width:760px; margin:0 auto; background:#fff; border:1px solid var(--borda);
           border-radius:12px; padding:2rem; }
