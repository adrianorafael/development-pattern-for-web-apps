# ─────────────────────────────────────────────────────────────
# .gitignore: projeto Next.js + Tailwind (Vercel)
# Parte de "Development Pattern for Web Apps": regra R1.
# COPIE ISTO ANTES DO PRIMEIRO `git add`.
# Confira depois: git check-ignore -v .env.local .vercel
# ─────────────────────────────────────────────────────────────

# Ambiente: valores reais NUNCA versionados.
# .env* pega .env, .env.local, .env.preview.local, .env.production.local...
.env*
!.env.example

# Dependências
/node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# Build
/.next/
/out/
/build
/dist
next-env.d.ts
*.tsbuildinfo

# Vercel: vínculo com o projeto (vercel link) e saída de `vercel build`
.vercel/

# Supabase CLI: estado local do `supabase link` e do `supabase start`.
# O que se versiona é supabase/config.toml, supabase/migrations/ e supabase/seed.sql.
supabase/.temp/
supabase/.branches/

# Dados reais: dump de banco é vazamento de dado pessoal.
# `supabase db dump` gera um .sql: guarde FORA do repositório.
*.sql
!supabase/migrations/*.sql
!supabase/seed.sql
*.sql.gz
*.dump
dumps/
backups/

# Testes
/coverage
/playwright-report
/test-results
/blob-report
/.playwright
qa/evidencias/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Chaves e certificados
*.pem
*.key
*.p12

# Editores e sistema
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
